# Firebase
FIREBASE_CREDENTIALS_PATH=firebase-credentials-local-language.json

# Google Cloud
GOOGLE_APPLICATION_CREDENTIALS=firebase-credentials-local-language.json

# Server
PORT=8000
HOST=0.0.0.0

# JWT Secret (generate with: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET=your-secret-key-here-change-this
JWT_ALGORITHM=HS256

# Email (Gmail SMTP — use an App Password, NOT your Google account password)
# Create one at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
SMTP_FROM=your-gmail@gmail.com

# Frontend URL (used in password reset links)
FRONTEND_URL=http://localhost:5173